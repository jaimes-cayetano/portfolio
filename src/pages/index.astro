import Education from "../components/Education.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
---

<BaseLayout
  title="Jhon Jaimes Cayetano · Fullstack Developer"
  description="Portafolio de Jhon Jaimes Cayetano, Fullstack Developer con experiencia en integración de IA, arquitectura de sistemas y desarrollo web."
>
  <Header />
  <main id="main-content">
    <Hero />
    <Experience />
    <Awards />
    <Education />
    <Contact />
