---
import { Image } from "astro:assets";
import { awards } from "../data/awards";
import IconExpand from "./icons/IconExpand.astro";
import { ui } from "../i18n/ui";
---

<section class="awards" id="reconocimientos" aria-labelledby="awards-title">
  <div class="container">
    <h2
      class="section-heading awards__title"
      id="awards-title"
      data-i18n-es={ui.es.awardsHeading}
      data-i18n-en={ui.en.awardsHeading}
    >
      {ui.es.awardsHeading}
    </h2>

    <ul class="awards__list">
      {
        awards.map((award) => {
          const labelEs = `${ui.es.awardsViewLarger}: ${award.title}`;
          const labelEn = `${ui.en.awardsViewLarger}: ${award.titleEn}`;
          const altEs = `${ui.es.awardsCertificate}: ${award.title}`;
          const altEn = `${ui.en.awardsCertificate}: ${award.titleEn}`;

          return (
            <li
              class:list={[
                "awards__item",
                { "awards__item--reverse": award.mediaFirst },
              ]}
              data-reveal
            >
              <div class="awards__body">
                <div class="awards__heading">
                  <h3
                    class="awards__item-title"
                    data-i18n-es={award.title}
                    data-i18n-en={award.titleEn}
                  >
                    {award.title}
                  </h3>
                  <p class="awards__meta">
                    {award.date} -{" "}
                    <span
                      data-i18n-es={award.issuer}
                      data-i18n-en={award.issuerEn}
                    >
                      {award.issuer}
                    </span>
                  </p>
                </div>
                <p
                  class="awards__description"
                  data-i18n-es={award.description}
                  data-i18n-en={award.descriptionEn}
                >
                  {award.description}
                </p>
              </div>

              <button
                class="awards__media"
                type="button"
                data-lightbox-trigger
                data-lightbox-src={award.image?.src}
                data-lightbox-alt={altEs}
                data-lightbox-title={award.title}
                aria-label={labelEs}
                data-i18n-attrs-es={JSON.stringify({
                  "aria-label": labelEs,
                  "data-lightbox-alt": altEs,
                  "data-lightbox-title": award.title,
                })}
                data-i18n-attrs-en={JSON.stringify({
                  "aria-label": labelEn,
                  "data-lightbox-alt": altEn,
                  "data-lightbox-title": award.titleEn,
                })}
              >
                {award.image ? (
                  <Image
                    class="awards__media-image"
                    src={award.image}
                    alt=""
                    width={422}
                    height={240}
                  />
                ) : (
                  <span class="awards__media-placeholder" aria-hidden="true" />
                )}
                <span class="awards__expand" aria-hidden="true">
                  <IconExpand />
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .awards {
    padding-block: var(--space-8);
  }

  .awards__title {
    margin-bottom: var(--space-6);
  }

  .awards__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .awards__item {
    display: flex;
    align-items: center;
    gap: var(--space-7);
  }

  .awards__item--reverse {
    flex-direction: row-reverse;
  }

  .awards__body {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-3);
  }

  .awards__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .awards__item-title {
    font-size: var(--fs-item-title);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
  }

  .awards__meta {
    font-size: var(--fs-meta);
    font-weight: var(--fw-semibold);
    color: var(--color-meta-strong);
  }

  .awards__description {
    color: var(--color-body);
  }

  .awards__media {
    position: relative;
    flex-shrink: 0;
    display: block;
    width: 26.375rem;
    max-width: 45%;
    aspect-ratio: 422 / 240;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: none;
  }

  .awards__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .awards__media-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-placeholder);
  }

  .awards__expand {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-bg);
    color: var(--color-ink);
    border-radius: 50%;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-ink) 20%, transparent);
    transition:
      transform var(--transition-hover),
      background-color var(--transition-hover),
      color var(--transition-hover);
  }

  .awards__media:hover .awards__expand,
  .awards__media:focus-visible .awards__expand {
    transform: scale(1.08);
    background: var(--color-primary);
    color: var(--color-bg);
  }

  @media (max-width: 48rem) {
    .awards__item,
    .awards__item--reverse {
      flex-direction: column;
      align-items: stretch;
    }

    .awards__media {
      width: 100%;
      max-width: 100%;
    }
  }
</style>
