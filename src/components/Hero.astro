---
import Button from "./Button.astro";
import IconDownload from "./icons/IconDownload.astro";
import IconLinkedIn from "./icons/IconLinkedIn.astro";
import IconGitHub from "./icons/IconGitHub.astro";
import { profile } from "../data/profile";
---

<section class="hero" id="sobre-mi" aria-labelledby="hero-title">
  <div class="container hero__inner" data-reveal>
    <h1 class="hero__title" id="hero-title">
      <span class="hero__wave" aria-hidden="true">👋</span> Hola, soy {
        profile.name
      }
    </h1>
    <p class="hero__subtitle">{profile.role}</p>
    <p class="hero__lead">
      <strong>{profile.yearsExperience}</strong>
      {" "}{profile.intro}
    </p>

    <div class="hero__actions">
      <Button
        href={profile.links.resume}
        label="Curriculum"
        accent="var(--color-primary)"
        download
      >
        <IconDownload slot="icon" />
      </Button>
      <Button
        href={profile.links.linkedin}
        label="LinkedIn"
        accent="var(--color-linkedin)"
        external
      >
        <IconLinkedIn slot="icon" />
      </Button>
      <Button
        href={profile.links.github}
        label="Github"
        accent="var(--color-github)"
        external
      >
        <IconGitHub slot="icon" />
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
    padding-block: var(--space-8);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .hero__title {
    font-size: var(--fs-hero);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  .hero__wave {
    display: inline-block;
    vertical-align: -0.08em;
  }

  .hero__subtitle {
    font-size: var(--fs-item-title);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  .hero__lead {
    max-width: 44rem;
    font-size: var(--fs-lead);
    color: var(--color-body);
  }

  .hero__lead strong {
    font-weight: var(--fw-bold);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 27rem;
  }
</style>
