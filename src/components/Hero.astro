---
import Button from "./Button.astro";
import IconDownload from "./icons/IconDownload.astro";
import IconLinkedIn from "./icons/IconLinkedIn.astro";
import IconGitHub from "./icons/IconGitHub.astro";
import { profile } from "../data/profile";
import { ui } from "../i18n/ui";
---

<section class="hero" id="sobre-mi" aria-labelledby="hero-title">
  <div class="container hero__inner" data-reveal>
    <h1 class="hero__title" id="hero-title">
      <span class="hero__wave" aria-hidden="true">👋</span>{" "}
      <span data-i18n-es={ui.es.heroGreeting} data-i18n-en={ui.en.heroGreeting}>
        {ui.es.heroGreeting}
      </span>{" "}
      {profile.name}
    </h1>
    <p class="hero__subtitle">{profile.role}</p>
    <p class="hero__lead">
      <strong
        data-i18n-es={profile.yearsExperience}
        data-i18n-en={profile.yearsExperienceEn}
      >
        {profile.yearsExperience}
      </strong>{" "}
      <span data-i18n-es={profile.intro} data-i18n-en={profile.introEn}>
        {profile.intro}
      </span>
    </p>

    <div class="hero__actions">
      <Button
        href={profile.links.resume}
        label={ui.es.heroResume}
        labelEn={ui.en.heroResume}
        accent="var(--color-primary)"
        download
      >
        <IconDownload slot="icon" />
      </Button>
      <Button
        href={profile.links.linkedin}
        label={ui.es.heroLinkedIn}
        labelEn={ui.en.heroLinkedIn}
        accent="var(--color-linkedin)"
        external
      >
        <IconLinkedIn slot="icon" />
      </Button>
      <Button
        href={profile.links.github}
        label={ui.es.heroGithub}
        labelEn={ui.en.heroGithub}
        accent="var(--color-github)"
        external
      >
        <IconGitHub slot="icon" />
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
    padding-block: var(--space-8);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .hero__title {
    font-size: var(--fs-hero);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  .hero__wave {
    display: inline-block;
    vertical-align: -0.08em;
  }

  .hero__subtitle {
    font-size: var(--fs-item-title);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  .hero__lead {
    max-width: 44rem;
    font-size: var(--fs-lead);
    color: var(--color-body);
  }

  .hero__lead strong {
    font-weight: var(--fw-bold);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 27rem;
  }
</style>
