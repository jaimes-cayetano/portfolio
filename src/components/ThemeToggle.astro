---
import IconSun from "./icons/IconSun.astro";
import IconMoon from "./icons/IconMoon.astro";
import { ui } from "../i18n/ui";
---

<button
  class="theme-toggle"
  type="button"
  id="theme-toggle"
  aria-label={ui.es.themeToDark}
>
  <IconSun class="theme-toggle__icon theme-toggle__icon--sun" />
  <IconMoon class="theme-toggle__icon theme-toggle__icon--moon" />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    border-radius: 50%;
    color: var(--color-ink);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .theme-toggle :global(.theme-toggle__icon) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .theme-toggle :global(.theme-toggle__icon--moon) {
    display: none;
  }

  .theme-toggle.is-dark :global(.theme-toggle__icon--sun) {
    display: none;
  }

  .theme-toggle.is-dark :global(.theme-toggle__icon--moon) {
    display: block;
  }
</style>

<script>
  import { ui } from "../i18n/ui";

  type Lang = "es" | "en";

  const STORAGE_KEY = "theme";
  const LANG_STORAGE_KEY = "lang";
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle");

  const getStoredLang = (): Lang => {
    try {
      return localStorage.getItem(LANG_STORAGE_KEY) === "en" ? "en" : "es";
    } catch {
      return "es";
    }
  };

  // Light is always the default until the visitor explicitly toggles —
  // system color-scheme preference is intentionally not consulted here.
  const resolveTheme = () => root.dataset.theme ?? "light";

  const syncButton = (lang: Lang = getStoredLang()) => {
    const isDark = resolveTheme() === "dark";
    button?.classList.toggle("is-dark", isDark);
    button?.setAttribute(
      "aria-label",
      isDark ? ui[lang].themeToLight : ui[lang].themeToDark,
    );
  };

  button?.addEventListener("click", () => {
    const next = resolveTheme() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Private browsing / disabled storage: the toggle still works for
      // this page view, it just won't be remembered next visit.
    }
    syncButton();
  });

  document.addEventListener("app:langchange", (event) => {
    syncButton((event as CustomEvent<{ lang: Lang }>).detail.lang);
  });

  syncButton();
</script>
