---
interface Props {
  href: string;
  label: string;
  labelEn?: string;
  accent: string;
  external?: boolean;
  download?: boolean;
}

const {
  href,
  label,
  labelEn,
  accent,
  external = false,
  download = false,
} = Astro.props;
---

<a
  class="btn"
  style={`--btn-accent: ${accent}`}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  download={download ? true : undefined}
>
  <span class="btn__icon" aria-hidden="true">
    <slot name="icon" />
  </span>
  <span class="btn__label" data-i18n-es={label} data-i18n-en={labelEn ?? label}>
    {label}
  </span>
</a>

<style>
  .btn {
    --btn-accent: var(--color-primary);
    display: inline-flex;
    flex: 1 0 auto;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    height: 2.3125rem;
    padding: 0.375rem var(--space-2);
    border: 1px solid var(--btn-accent);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    transition:
      background-color var(--transition-hover),
      border-color var(--transition-hover),
      color var(--transition-hover),
      transform var(--transition-hover),
      box-shadow var(--transition-hover);
  }

  .btn:focus-visible {
    background-color: color-mix(in srgb, var(--btn-accent) 12%, transparent);
    transform: translateY(-1px);
  }

  @media (hover: hover) {
    .btn:hover {
      background-color: color-mix(in srgb, var(--btn-accent) 12%, transparent);
      transform: translateY(-1px);
    }
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn__icon {
    display: inline-flex;
    color: var(--btn-accent);
  }
</style>
