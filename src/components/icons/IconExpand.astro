  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M9 4H4V9M15 4H20V9M20 15V20H15M4 15V20H9"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
