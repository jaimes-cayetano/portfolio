---
import "../styles/global.css";
import { profile } from "../data/profile";
import { ui } from "../i18n/ui";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  titleEn: string;
  description: string;
  descriptionEn: string;
}

const { title, titleEn, description, descriptionEn } = Astro.props;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  jobTitle: profile.role,
  url: canonicalURL.toString(),
  sameAs: [profile.links.linkedin, profile.links.github],
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        var storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.dataset.theme = storedTheme;
        }
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title data-i18n-es={title} data-i18n-en={titleEn}>{title}</title>
    <meta
      name="description"
      content={description}
      data-i18n-attrs-es={JSON.stringify({ content: description })}
      data-i18n-attrs-en={JSON.stringify({ content: descriptionEn })}
    />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a
      class="skip-link"
      href="#main-content"
      data-i18n-es={ui.es.skipLink}
      data-i18n-en={ui.en.skipLink}
    >
      {ui.es.skipLink}
    </a>
    <slot />
    <script>
      const STORAGE_KEY = "lang";

      function applyLanguage(lang: "es" | "en") {
        document.documentElement.lang = lang;

        document
          .querySelectorAll<HTMLElement>("[data-i18n-es]")
          .forEach((el) => {
            const text = lang === "en" ? el.dataset.i18nEn : el.dataset.i18nEs;
            if (text !== undefined) el.textContent = text;
          });

        document
          .querySelectorAll<HTMLElement>("[data-i18n-attrs-es]")
          .forEach((el) => {
            const raw =
              lang === "en" ? el.dataset.i18nAttrsEn : el.dataset.i18nAttrsEs;
            if (!raw) return;
            const attrs = JSON.parse(raw) as Record<string, string>;
            for (const [name, value] of Object.entries(attrs)) {
              el.setAttribute(name, value);
            }
          });
      }

      const getStoredLang = (): "es" | "en" => {
        try {
          return localStorage.getItem(STORAGE_KEY) === "en" ? "en" : "es";
        } catch {
          return "es";
        }
      };

      applyLanguage(getStoredLang());

      document.addEventListener("app:langchange", (event) => {
        applyLanguage(
          (event as CustomEvent<{ lang: "es" | "en" }>).detail.lang,
        );
      });
    </script>
    <script>
      const revealElements =
        document.querySelectorAll<HTMLElement>("[data-reveal]");

      if ("IntersectionObserver" in window && revealElements.length) {
        revealElements.forEach((el) => {
          const rect = el.getBoundingClientRect();
          const alreadyVisible =
            rect.top < window.innerHeight && rect.bottom > 0;
          if (!alreadyVisible) el.classList.add("reveal-pending");
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );

        revealElements.forEach((el) => observer.observe(el));
      }
    </script>
    <Analytics />
  </body>
</html>
